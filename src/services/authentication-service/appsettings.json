{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", 
      "Serilog.Sinks.File", 
      "Serilog.Sinks.Elasticsearch" 
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworCore": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Warning",
        "Microsoft.AspNetCore.Authentication.Cookies": "Warning",
        "System": "Warning",
        "Duende":"Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd:HH:mm:ss} {Level:u3}] {Message:lj} |{SourceContext} | {NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./diagnostics/diagnostic.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "UserService": {
    "BaseUrl": "http://localhost:5002"
  },
  "Certificate": {
    "Password": "password"
  }
}